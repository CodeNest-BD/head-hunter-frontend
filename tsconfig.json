{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2020", "es2022.error", "webworker"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["vitest/globals"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "downlevelIteration": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.js",
    "src/config/sentry.config.js",
    "src/features/plot-digitizer/components/data-table/EditCell.jsx",
    "src/shared/store/types/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
