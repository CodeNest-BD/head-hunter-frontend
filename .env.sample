NEXT_PUBLIC_API_URL=http://localhost:8080/v1
NEXT_PUBLIC_API_URL_V3=
NEXT_PUBLIC_AI_URL=
NEXT_PUBLIC_AI_CHAT_URL=
NEXT_PUBLIC_AI_SEARCH_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Microsoft Entra ID SSO (MSAL). Dev uses the HeadHunter test-tenant authority;
# prod uses the multitenant "organizations" authority.
# Test tenant example: NEXT_PUBLIC_MSAL_CLIENT_ID=<your-msal-client-id>
# Dev:  NEXT_PUBLIC_MSAL_AUTHORITY=https://login.microsoftonline.com/<your-tenant-id>
# Prod: NEXT_PUBLIC_MSAL_AUTHORITY=https://login.microsoftonline.com/organizations
# Example: NEXT_PUBLIC_MSAL_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_MSAL_CLIENT_ID=
NEXT_PUBLIC_MSAL_AUTHORITY=
NEXT_PUBLIC_MSAL_REDIRECT_URI=

# Contact shown on auth dead-ends (unauthorized page, SSO sign-in failures).
# Falls back to support@headhunter.pro if unset.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_FILES_UPLOAD_LIMIT=
NEXT_PUBLIC_SYNC_FUSION_LICENSE_KEY=

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=

# Leave NEXT_PUBLIC_ANALYTICS_KEY empty to disable analytics
NEXT_PUBLIC_ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_HOST=https://app.posthog.com

NEXT_PUBLIC_ENVIRONMENT=

NEXT_PUBLIC_NOTEBOOK_URL=

NEXT_PUBLIC_COPILOT_API_URL=

# MSW (Mock Service Worker) Configuration
# Set to 'true' to enable API mocking in development environment
NEXT_PUBLIC_ENABLE_MSW=false

# Set to 'true' to enable cell editing in extraction tables
NEXT_PUBLIC_ENABLE_EXTRACTION_TABLE_EDIT=false


NEXT_PUBLIC_FCM_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=